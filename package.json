{
  "name": "kodiak-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/no-timers-check.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:battery": "node scripts/no-timers-check.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build:test": "node scripts/no-timers-check.mjs && tsc --noEmit -p tsconfig.json && vite build --outDir dist-test",
    "sim": "node scripts/sim.mjs",
    "test:offline": "node scripts/offline-test.mjs",
    "test:hidden": "node scripts/hidden-test.mjs",
    "test:noscroll": "node scripts/noscroll.mjs",
    "test:contrast": "node scripts/axe-check.mjs",
    "course-table": "node scripts/course-table.ts > docs/COURSE-CHECK.md"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "playwright": "1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
